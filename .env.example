# Oakdale Men's Softball — production environment
#
#   cp .env.example .env
#   # then edit .env — never commit it
#
# Generate a session secret:
#   openssl rand -hex 32
#
# DATA_DIR=/data is set inside the container (Dockerfile / Fly / Compose).
# Do not override it when using docker compose, Fly.io, or the production image.
# On a persistent volume that path is where league.db is written.

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=League Commissioner

# Required in production so logins survive restarts. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Disables the demo manager/player logins. Leave false in production.
SEED_DEMO_USERS=false

NODE_ENV=production

# Host port published by docker compose (${PORT:-3001}:3001).
# The process inside the container always listens on 3001.
PORT=3001

# Optional: only for plain HTTP (no TLS). Production behind HTTPS should omit this.
# INSECURE_COOKIES=true

# Optional demo-account overrides (ignored when SEED_DEMO_USERS=false):
# DEMO_MANAGER_PASSWORD=
# DEMO_PLAYER_PASSWORD=

# Public site URL used in signup emails.
PUBLIC_APP_URL=https://oakdale-mens-softball.fly.dev

# Where to send "someone just signed up" notices. Comma-separated is OK.
# Falls back to ADMIN_EMAIL when that address is a real inbox (not *.local).
SIGNUP_NOTIFY_EMAIL=you@example.com

# Sender shown on outbound mail. Must be allowed by your mail provider.
# MAIL_FROM=Oakdale Men's Softball <noreply@your-domain.com>

# Option A — Resend (https://resend.com). Preferred on Fly / Docker.
# RESEND_API_KEY=re_xxxxxxxxx

# Option B — SMTP (Gmail app password, or any SMTP host).
# SMTP_URL=smtps://user%40gmail.com:app-password@smtp.gmail.com:465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_SECURE=true
